# Bharat Sentinel AI - Infrastructure Intelligence Platform
# Environment Configuration

# Next.js App Secret
JWT_SECRET=bharat_sentinel_ai_super_secret_jwt_key_2026

# Database Connection (MongoDB URI)
# If left default or disconnected, system falls back gracefully to initialized in-memory database with persistent state in session/memory
MONGODB_URI=mongodb://localhost:27017/bharat_sentinel_ai

# Google Gemini Vision API Key (Optional for real AI computer vision)
# If empty, system automatically uses clearly labelled Bharat Sentinel AI Vision Demo Mode
GEMINI_API_KEY=

# Public Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# File Upload Directory
UPLOAD_DIR=public/uploads
